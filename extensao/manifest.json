{
    "manifest_version": 3,
    "name": "Red Code - vídeo no canto",
    "version": "1.0.5",
    "description": "Avisa o Red Code qual vídeo do YouTube está tocando e em que segundo, para ele mostrar o mesmo vídeo no canto.",
    "background": {
        "service_worker": "fundo.js"
    },
    "host_permissions": [
        "http://127.0.0.1/*",
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://m.youtube.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://music.youtube.com/*",
                "*://m.youtube.com/*"
            ],
            "js": [
                "pagina.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://music.youtube.com/*",
                "*://m.youtube.com/*"
            ],
            "js": [
                "principal.js"
            ],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "permissions": [
        "scripting"
    ]
}
